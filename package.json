{
  "name": "ghabryel-page",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng build --configuration production --base-href https://ghabryelhenrique.com.br/ && npx angular-cli-ghpages --dir=dist/ghabryelPage/browser --cname=ghabryelhenrique.com.br"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/slim": "^3.9.1",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.184.1",
    "d3": "^7.9.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.10",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "angular-cli-ghpages": "^2.0.3",
    "heic-convert": "^2.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
